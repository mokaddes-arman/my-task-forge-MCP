# Copy this file to .env and fill in an authorized QA account.
# Never commit the real .env file.
BASE_URL=https://mytaskforge.net/
owner_email=replace-with-authorized-qa-account@example.com
# Quote passwords that contain # (dotenv treats an unquoted # as a comment).
owner_password="replace-with-authorized-qa-password"
# Optional; defaults to /abdul-s-workspace
WORKSPACE_PATH=/abdul-s-workspace
