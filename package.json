{
  "name": "taskforge-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + JavaScript (CommonJS) QA automation suite for TaskForge",
  "scripts": {
    "test": "playwright test",
    "test:auth": "playwright test tests/00-auth.spec.js",
    "test:auth:chrome": "playwright test tests/00-auth.spec.js --project=auth-chrome",
    "test:auth:firefox": "playwright test tests/00-auth.spec.js --project=auth-firefox",
    "test:auth:webkit": "playwright test tests/00-auth.spec.js --project=auth-webkit",
    "test:auth:all": "playwright test tests/00-auth.spec.js --project=auth-chrome --project=auth-firefox --project=auth-webkit",
    "test:auth:headed": "playwright test tests/00-auth.spec.js --project=auth-chrome --headed",
    "test:setup": "playwright test tests/auth.setup.js --project=setup",
    "test:modules": "playwright test --project=modules-chrome --project=modules-firefox --project=modules-webkit",
    "test:modules:chrome": "playwright test --project=modules-chrome",
    "test:modules:firefox": "playwright test --project=modules-firefox",
    "test:modules:webkit": "playwright test --project=modules-webkit",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.9"
  }
}
